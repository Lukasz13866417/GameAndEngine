vmesh 1.0

# A genuine three-dimensional cube in world space. Each face owns four
# vertices because color is discontinuous across the face seams.
info {
    name = "colored 3D cube";
    source/tool = "hand-authored example";
}

vertices 24 {
    fields {
        position : f32x3;
        color/0 : f32x4;
    }
    data {
        # front (+Z)
        [-0.75, -0.75,  0.75] [0.08, 0.42, 0.90, 1.00];
        [ 0.75, -0.75,  0.75] [0.08, 0.42, 0.90, 1.00];
        [ 0.75,  0.75,  0.75] [0.08, 0.42, 0.90, 1.00];
        [-0.75,  0.75,  0.75] [0.08, 0.42, 0.90, 1.00];

        # back (-Z)
        [ 0.75, -0.75, -0.75] [0.04, 0.16, 0.42, 1.00];
        [-0.75, -0.75, -0.75] [0.04, 0.16, 0.42, 1.00];
        [-0.75,  0.75, -0.75] [0.04, 0.16, 0.42, 1.00];
        [ 0.75,  0.75, -0.75] [0.04, 0.16, 0.42, 1.00];

        # right (+X)
        [ 0.75, -0.75,  0.75] [0.08, 0.72, 0.82, 1.00];
        [ 0.75, -0.75, -0.75] [0.08, 0.72, 0.82, 1.00];
        [ 0.75,  0.75, -0.75] [0.08, 0.72, 0.82, 1.00];
        [ 0.75,  0.75,  0.75] [0.08, 0.72, 0.82, 1.00];

        # left (-X)
        [-0.75, -0.75, -0.75] [0.38, 0.18, 0.72, 1.00];
        [-0.75, -0.75,  0.75] [0.38, 0.18, 0.72, 1.00];
        [-0.75,  0.75,  0.75] [0.38, 0.18, 0.72, 1.00];
        [-0.75,  0.75, -0.75] [0.38, 0.18, 0.72, 1.00];

        # top (+Y)
        [-0.75,  0.75,  0.75] [0.46, 0.88, 1.00, 1.00];
        [ 0.75,  0.75,  0.75] [0.46, 0.88, 1.00, 1.00];
        [ 0.75,  0.75, -0.75] [0.46, 0.88, 1.00, 1.00];
        [-0.75,  0.75, -0.75] [0.46, 0.88, 1.00, 1.00];

        # bottom (-Y)
        [-0.75, -0.75, -0.75] [0.03, 0.09, 0.20, 1.00];
        [ 0.75, -0.75, -0.75] [0.03, 0.09, 0.20, 1.00];
        [ 0.75, -0.75,  0.75] [0.03, 0.09, 0.20, 1.00];
        [-0.75, -0.75,  0.75] [0.03, 0.09, 0.20, 1.00];
    }
}

faces 12 {
    [ 0,  1,  2]; [ 0,  2,  3];
    [ 4,  5,  6]; [ 4,  6,  7];
    [ 8,  9, 10]; [ 8, 10, 11];
    [12, 13, 14]; [12, 14, 15];
    [16, 17, 18]; [16, 18, 19];
    [20, 21, 22]; [20, 22, 23];
}

# Per-face authored edges. Coincident seams deliberately remain separate
# because the render vertices on either side are separate.
edges 24 {
    [ 0,  1]; [ 1,  2]; [ 2,  3]; [ 3,  0];
    [ 4,  5]; [ 5,  6]; [ 6,  7]; [ 7,  4];
    [ 8,  9]; [ 9, 10]; [10, 11]; [11,  8];
    [12, 13]; [13, 14]; [14, 15]; [15, 12];
    [16, 17]; [17, 18]; [18, 19]; [19, 16];
    [20, 21]; [21, 22]; [22, 23]; [23, 20];
}
